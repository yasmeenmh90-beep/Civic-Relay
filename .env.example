# Copy to .env and fill in for a real deployment. Locally, none of this is
# required - the app runs with safe defaults (SQLite, local disk, no auth
# secret rotation) out of the box.

# --- Database (required for production - SQLite is dev-only) ---
DATABASE_URL=postgresql://civicrelay:civicrelay@db:5432/civicrelay

# --- Auth (required for production) ---
JWT_SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS (required for production - "*" is dev-only) ---
ALLOWED_ORIGINS=https://your-frontend-domain.com

# --- Logging ---
LOG_FORMAT=json
LOG_LEVEL=INFO

# --- Background jobs ---
# Run the Tracking Agent sweep in exactly ONE process/replica. Set this to 0
# on every other replica if you run more than one (see app/main.py).
RUN_BACKGROUND_SCHEDULER=1
TRACKING_INTERVAL_SECONDS=30

# --- Dev-only routes ---
# /dev/reset wipes all data - never enable this in production.
ENABLE_DEV_ROUTES=0

# --- Bedrock / Strands (optional - falls back to deterministic logic without it) ---
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- S3 image storage (optional - falls back to local disk without it) ---
S3_BUCKET=

# --- Municipal Open311 API (optional - falls back to a local ticket ref without it) ---
MUNICIPAL_API_BASE_URL=
MUNICIPAL_API_KEY=
MUNICIPAL_JURISDICTION_ID=
